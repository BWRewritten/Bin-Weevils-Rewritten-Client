{
  "name": "bwrewritten",
  "version": "1.0.4",
  "description": "Desktop client for binweevils.app",
  "main": "main.js",
  "bugs": {
    "url": "https://github.com/BWRewritten/Bin-Weevils-Rewritten-Client/issues"
  },
  "icon": "icon",
  "build": {
    "icon": "icon",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "artifactName": "BWR Installer ${version}-${arch}.${ext}",
    "productName": "Bin Weevils Rewritten",
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!.js",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "linux": {
      "icon": "icon.png",
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "tar.xz"
      ],
      "category": "Game"
    },
    "mac": {
      "asar": false,
      "icon": "icon.icns"
    }
  },
  "homepage": "https://github.com/BWRewritten",
  "repository": "https://github.com/BWRewritten/Bin-Weevils-Rewritten-Client",
  "author": {
    "name": "BWRewritten",
    "email": "bwrewritten@gmail.com"
  },
  "license": "CC0-1.0",
  "scripts": {
    "debugApp": "electron .",
    "buildWin": "electron-builder --win --x64 --ia32 --arm64",
    "buildMac": "electron-builder --mac --x64 --arm64",
    "buildLinux": "electron-builder --linux deb rpm AppImage tar.xz --x64 --arm64",
    "buildHelp": "electron-builder --help"
  },
  "devDependencies": {
    "electron": "^11.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-find": "^1.0.7",
    "electron-packager": "^17.1.2",
    "electron-updater": "^6.3.9"
  }
}
